    <!-- PDF Header -->
    <div style="border-bottom: 2px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h1 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 4px 0;">${Ee.companyName||"\u0646\u0638\u0627\u0645 \u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u062E\u0632\u0648\u0646 \u0648\u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A"}</h1>
        <p style="font-size: 12px; color: #64748b; margin: 0;">${Ee.companySubtitle||"\u062A\u0642\u0631\u064A\u0631 \u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A \u0627\u0644\u0645\u0633\u062A\u0642\u0644\u0629 \u0648\u0627\u0644\u064A\u0648\u0645\u064A\u0629"}</p>
        <p style="font-size: 11px; color: #64748b; margin: 4px 0 0 0;">${Ee.address?`\u0627\u0644\u0639\u0646\u0648\u0627\u0646: ${Ee.address}`:""} ${Ee.phone?`| \u0647\u0627\u062A\u0641: ${Ee.phone}`:""}</p>
      </div>
      <div style="text-align: left; background-color: #faf5ff; padding: 10px 14px; border-radius: 12px; border: 1px solid #e9d5ff;">
        <h2 style="font-size: 15px; font-weight: 800; color: #7e22ce; margin: 0 0 4px 0;">${dn}</h2>
        <p style="font-size: 11px; color: #6b21a8; margin: 0;">${Re}</p>
        <p style="font-size: 10px; color: #9333ea; margin: 4px 0 0 0;">\u062A\u0627\u0631\u064A\u062E \u0627\u0644\u062A\u0642\u0631\u064A\u0631: ${new Date().toLocaleDateString("ar-SA")} - ${new Date().toLocaleTimeString("ar-SA")}</p>
      </div>
    </div>

    <!-- Financial KPIs summary -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 18px;">
      <div style="background-color: #ecfdf5; border: 1px solid #a7f3d0; padding: 10px 12px; border-radius: 10px;">
        <span style="font-size: 10px; color: #065f46; font-weight: 700;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A (\u0631\u064A\u0627\u0644 \u064A\u0645\u0646\u064A)</span>
        <div style="font-size: 17px; font-weight: 900; color: #047857; margin-top: 3px;">
          ${Math.round(ye).toLocaleString()} <span style="font-size: 10px;">\u0631.\u064A</span>
        </div>
      </div>

      <div style="background-color: #fffbeb; border: 1px solid #fde68a; padding: 10px 12px; border-radius: 10px;">
        <span style="font-size: 10px; color: #92400e; font-weight: 700;">\u0627\u0644\u0645\u0639\u0627\u062F\u0644 (\u0631\u064A\u0627\u0644 \u0633\u0639\u0648\u062F\u064A)</span>
        <div style="font-size: 17px; font-weight: 900; color: #b45309; margin-top: 3px;">
          ${Math.round(S).toLocaleString()} <span style="font-size: 10px;">\u0631.\u0633</span>
        </div>
      </div>

      <div style="background-color: #eff6ff; border: 1px solid #bfdbfe; padding: 10px 12px; border-radius: 10px;">
        <span style="font-size: 10px; color: #1e40af; font-weight: 700;">\u0627\u0644\u0645\u0639\u0627\u062F\u0644 (\u062F\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064A\u0643\u064A)</span>
        <div style="font-size: 17px; font-weight: 900; color: #1d4ed8; margin-top: 3px;">
          ${Q.toLocaleString(void 0,{minimumFractionDigits:2,maximumFractionDigits:2})} <span style="font-size: 10px;">$</span>
        </div>
      </div>

      <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 10px 12px; border-radius: 10px;">
        <span style="font-size: 10px; color: #475569; font-weight: 700;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0639\u0645\u0644\u064A\u0627\u062A \u0648\u0627\u0644\u0642\u0637\u0639</span>
        <div style="font-size: 17px; font-weight: 900; color: #0f172a; margin-top: 3px;">
          ${Ne.length} <span style="font-size: 10px; font-weight: normal;">\u0639\u0645\u0644\u064A\u0629 (${r} \u0642\u0637\u0639\u0629)</span>
        </div>
      </div>
    </div>

    <!-- Sales Table organized by Date -->
    <div style="margin-bottom: 20px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: right;">
        <thead>
          <tr style="background-color: #1e1b4b; color: #ffffff;">
            <th style="padding: 8px 6px; border: 1px solid #312e81; width: 30px; text-align: center;">#</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81; width: 85px;">\u0627\u0644\u062A\u0627\u0631\u064A\u062E</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81; width: 130px;">\u0627\u0644\u0645\u0634\u062A\u0631\u064A / \u0627\u0644\u0639\u0645\u064A\u0644</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81;">\u0627\u0644\u0628\u064A\u0627\u0646 / \u0627\u0644\u0645\u0648\u0627\u062F \u0627\u0644\u0645\u0628\u0627\u0639\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81; width: 55px; text-align: center;">\u0627\u0644\u0643\u0645\u064A\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81; width: 95px;">\u0633\u0639\u0631 \u0627\u0644\u062D\u0628\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81; width: 110px;">\u0627\u0644\u0625\u062C\u0645\u0627\u0644\u064A \u0628\u0627\u0644\u0639\u0645\u0644\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81; width: 95px;">\u0627\u0644\u0645\u0639\u0627\u062F\u0644 (\u0631.\u064A)</th>
            <th style="padding: 8px 8px; border: 1px solid #312e81;">\u0645\u0644\u0627\u062D\u0638\u0627\u062A</th>
          </tr>
        </thead>
        <tbody>
          ${Ne.length===0?`
            <tr>
              <td colspan="9" style="text-align: center; padding: 16px; color: #94a3b8; border: 1px solid #e2e8f0;">\u0644\u0627 \u062A\u0648\u062C\u062F \u0645\u0628\u064A\u0639\u0627\u062A \u0645\u0633\u062C\u0644\u0629 \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0641\u062A\u0631\u0629</td>
            </tr>
          `:Ne.map((x,B)=>{var p;let F=x.currency||"YER",_=((p=PA[F])==null?void 0:p.symbol)||F,h=Math.round(it(x.totalPrice,F,"YER"));return`
              <tr style="background-color: ${B%2===0?"#ffffff":"#f8fafc"};">
                <td style="padding: 6px 6px; border: 1px solid #e2e8f0; text-align: center; color: #64748b;">${B+1}</td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-family: monospace; font-weight: bold; color: #334155;">${x.date}</td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-weight: bold; color: #0f172a;">${x.buyerName}</td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; color: #1e293b;">${x.material}</td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; text-align: center; font-weight: bold;">${x.quantity}</td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-family: monospace; font-weight: 600;">
                  ${x.unitPrice.toLocaleString()} <span style="font-size: 9px; color: #64748b;">${_}</span>
                </td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-weight: 800; color: #6b21a8; background-color: #faf5ff;">
                  ${x.totalPrice.toLocaleString()} <span style="font-size: 10px;">${_}</span>
                </td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-weight: 700; color: #047857; font-family: monospace;">
                  ${h.toLocaleString()} \u0631.\u064A
                </td>
                <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-size: 10px; color: #64748b;">${x.notes||"-"}</td>
              </tr>
            `}).join("")}
        </tbody>
        <tfoot>
          <tr style="background-color: #f1f5f9; font-weight: bold; border-top: 2px solid #cbd5e1;">
            <td colspan="4" style="padding: 8px 10px; border: 1px solid #cbd5e1; text-align: left;">\u0627\u0644\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0639\u0627\u0645 \u0644\u0643\u0627\u0641\u0629 \u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A:</td>
            <td style="padding: 8px; border: 1px solid #cbd5e1; text-align: center; font-weight: 900;">${r}</td>
            <td style="padding: 8px; border: 1px solid #cbd5e1;">-</td>
            <td colspan="2" style="padding: 8px; border: 1px solid #cbd5e1; font-weight: 900; color: #047857; font-size: 13px;">
              ${Math.round(ye).toLocaleString()} \u0631.\u064A <span style="font-size: 10px; font-weight: normal; color: #64748b;">(\u2248 ${Math.round(S).toLocaleString()} \u0631.\u0633 | ${Q.toLocaleString(void 0,{maximumFractionDigits:1})}$)</span>
            </td>
            <td style="padding: 8px; border: 1px solid #cbd5e1;"></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Signatures Footer -->
    <div style="margin-top: 30px; padding-top: 14px; border-top: 1px solid #cbd5e1; display: flex; justify-content: space-between; align-items: center; text-align: center; font-size: 11px; color: #475569;">
      <div style="width: 30%;">
        <p style="font-weight: bold; margin-bottom: 22px;">\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A / \u0627\u0644\u0645\u062D\u0627\u0633\u0628</p>
        <p style="color: #94a3b8;">\u0627\u0644\u062A\u0648\u0642\u064A\u0639: .....................</p>
      </div>

      <div style="width: 30%;">
        <p style="font-weight: bold; margin-bottom: 22px;">\u0627\u0644\u0645\u062F\u0642\u0642 \u0627\u0644\u0645\u0627\u0644\u064A</p>
        <p style="color: #94a3b8;">\u0627\u0644\u062A\u0648\u0642\u064A\u0639: .....................</p>
      </div>

      <div style="width: 30%;">
        <p style="font-weight: bold; margin-bottom: 22px;">\u0627\u0639\u062A\u0645\u0627\u062F \u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u0646\u0634\u0623\u0629</p>
        <p style="color: #94a3b8;">\u0627\u0644\u062A\u0648\u0642\u064A\u0639: .....................</p>
      </div>
    </div>
  `;try{let x=await xp(()=>Promise.resolve().then(()=>(ah(),oh)).then(F=>F.h),[]),B=x.default||x,p={margin:8,filename:`\u062A\u0642\u0631\u064A\u0631_\u0633\u062C\u0644_\u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A_\u0627\u0644\u0645\u0646\u0638\u0645_${new Date().toISOString().slice(0,10)}.pdf`,image:{type:"jpeg",quality:.98},html2canvas:{scale:2,useCORS:!0,letterRendering:!0},jsPDF:{unit:"mm",format:"a4",orientation:"landscape"}};return await B().set(p).from(w).save(),!0}catch(x){console.error("PDF export error:",x);let B=window.open("","_blank");return B&&(B.document.write(`
        <!DOCTYPE html>
        <html dir="rtl" lang="ar">
        <head>
          <title>${dn}</title>
          <style>
            body { font-family: system-ui, sans-serif; padding: 20px; direction: rtl; }
            table { width: 100%; border-collapse: collapse; margin-top: 15px; }
            th, td { border: 1px solid #ccc; padding: 8px; text-align: right; }
            th { background: #f1f5f9; }
          </style>
        </head>
        <body>
          ${w.innerHTML}
          <script>
            window.onload = function() {
              window.print();
            };
          <\/script>
        </body>
        </html>
      `),B.document.close()),!1}},Bp=async(Pt,dn,Re,Ee,it)=>{let Ne=Pt.filter(p=>p.movementType==="issued").reduce((p,F)=>p+F.quantity,0),ye=Pt.filter(p=>p.movementType==="returned").reduce((p,F)=>p+F.quantity,0),S=Ne-ye,Q=Pt.filter(p=>p.invoiceType==="cash").length,r=Pt.filter(p=>p.invoiceType==="deferred").length,w={};Pt.forEach(p=>{let F=it.find(C=>C.id===p.itemId),_=(F==null?void 0:F.code)||"---",h=p.itemName;w[h]||(w[h]={code:_,name:p.itemName,unit:p.unit||"\u0642\u0637\u0639\u0629",issued:0,returned:0}),p.movementType==="issued"?w[h].issued+=p.quantity:w[h].returned+=p.quantity});let x=Object.values(w),B=document.createElement("div");B.style.direction="rtl",B.style.fontFamily='system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',B.style.padding="24px",B.style.backgroundColor="#ffffff",B.style.color="#0f172a",B.style.width="800px",B.innerHTML=`
    <!-- PDF Header -->
    <div style="border-bottom: 2px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h1 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 4px 0;">${Ee.companyName||"\u0646\u0638\u0627\u0645 \u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u062E\u0632\u0648\u0646"}</h1>
        <p style="font-size: 12px; color: #64748b; margin: 0;">${Ee.companySubtitle||"\u062A\u0642\u0631\u064A\u0631 \u062D\u0631\u0643\u0629 \u0627\u0644\u0635\u0627\u062F\u0631 \u0648\u0627\u0644\u0645\u0631\u062A\u062C\u0639"}</p>
        <p style="font-size: 11px; color: #64748b; margin: 4px 0 0 0;">${Ee.address?`\u0627\u0644\u0639\u0646\u0648\u0627\u0646: ${Ee.address}`:""} ${Ee.phone?`| \u0647\u0627\u062A\u0641: ${Ee.phone}`:""}</p>
      </div>
      <div style="text-align: left; background-color: #f8fafc; padding: 10px 14px; border-radius: 12px; border: 1px solid #e2e8f0;">
        <h2 style="font-size: 16px; font-weight: 700; color: #d97706; margin: 0 0 4px 0;">${dn}</h2>
        <p style="font-size: 11px; color: #475569; margin: 0;">${Re}</p>
        <p style="font-size: 10px; color: #94a3b8; margin: 4px 0 0 0;">\u062A\u0627\u0631\u064A\u062E \u0627\u0644\u062A\u0635\u062F\u064A\u0631: ${new Date().toLocaleDateString("ar-SA")} - ${new Date().toLocaleTimeString("ar-SA")}</p>
      </div>
    </div>

    <!-- Statistical Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px;">
      <div style="background-color: #fffbeb; border: 1px solid #fef3c7; padding: 12px; border-radius: 12px;">
        <span style="font-size: 11px; color: #b45309; font-weight: 600;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0635\u0627\u062F\u0631</span>
        <div style="font-size: 20px; font-weight: 800; color: #78350f; margin-top: 4px;">${Ne.toLocaleString()}</div>
      </div>

      <div style="background-color: #ecfdf5; border: 1px solid #d1fae5; padding: 12px; border-radius: 12px;">
        <span style="font-size: 11px; color: #047857; font-weight: 600;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0645\u0631\u062A\u062C\u0639</span>
        <div style="font-size: 20px; font-weight: 800; color: #064e3b; margin-top: 4px;">${ye.toLocaleString()}</div>
      </div>

      <div style="background-color: #f0f9ff; border: 1px solid #e0f2fe; padding: 12px; border-radius: 12px;">
        <span style="font-size: 11px; color: #0369a1; font-weight: 600;">\u0635\u0627\u0641\u064A \u0627\u0644\u0643\u0645\u064A\u0629 \u0627\u0644\u0635\u0627\u062F\u0631\u0629</span>
        <div style="font-size: 20px; font-weight: 800; color: #0c4a6e; margin-top: 4px;">${S.toLocaleString()}</div>
      </div>

      <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 12px;">
        <span style="font-size: 11px; color: #475569; font-weight: 600;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u062D\u0631\u0643\u0627\u062A</span>
        <div style="font-size: 20px; font-weight: 800; color: #1e293b; margin-top: 4px;">${Pt.length} <span style="font-size: 11px; font-weight: normal;">(\u0646\u0642\u062F\u064A: ${Q} / \u0622\u062C\u0644: ${r})</span></div>
      </div>
    </div>

    <!-- Section 1: Item Aggregated Summary Table -->
    <div style="margin-bottom: 24px;">
      <h3 style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 8px; border-right: 4px solid #d97706; padding-right: 8px;">
        \u0623\u0648\u0644\u0627\u064B: \u0645\u0644\u062E\u0635 \u0625\u062D\u0635\u0627\u0626\u064A \u0628\u0627\u0644\u0643\u0645\u064A\u0627\u062A \u062D\u0633\u0628 \u0627\u0644\u0623\u0635\u0646\u0627\u0641 (\u0627\u0644\u0635\u0627\u062F\u0631 \u0648\u0627\u0644\u0645\u0631\u062A\u062C\u0639 \u0648\u0627\u0644\u0635\u0627\u0641\u064A)
      </h3>
      <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: right;">
        <thead>
          <tr style="background-color: #f1f5f9; color: #334155;">
            <th style="padding: 8px 10px; border: 1px solid #cbd5e1;">\u0643\u0648\u062F \u0627\u0644\u0635\u0646\u0641</th>
            <th style="padding: 8px 10px; border: 1px solid #cbd5e1;">\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641</th>
            <th style="padding: 8px 10px; border: 1px solid #cbd5e1;">\u0627\u0644\u0648\u062D\u062F\u0629</th>
            <th style="padding: 8px 10px; border: 1px solid #cbd5e1; background-color: #fef3c7; color: #92400e;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0635\u0627\u062F\u0631</th>
            <th style="padding: 8px 10px; border: 1px solid #cbd5e1; background-color: #d1fae5; color: #065f46;">\u0625\u062C\u0645\u0627\u0644\u064A \u0627\u0644\u0645\u0631\u062A\u062C\u0639</th>
            <th style="padding: 8px 10px; border: 1px solid #cbd5e1; background-color: #e0f2fe; color: #075985;">\u0635\u0627\u0641\u064A \u0627\u0644\u062D\u0631\u0643\u0629</th>
          </tr>
        </thead>
        <tbody>
          ${x.length===0?`
            <tr>
              <td colspan="6" style="text-align: center; padding: 12px; color: #94a3b8; border: 1px solid #e2e8f0;">\u0644\u0627 \u062A\u0648\u062C\u062F \u062D\u0631\u0643\u0629 \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0641\u062A\u0631\u0629</td>
            </tr>
          `:x.map((p,F)=>`
            <tr style="background-color: ${F%2===0?"#ffffff":"#f8fafc"};">
              <td style="padding: 7px 10px; border: 1px solid #e2e8f0; font-family: monospace; font-weight: bold;">${p.code}</td>
              <td style="padding: 7px 10px; border: 1px solid #e2e8f0; font-weight: bold; color: #0f172a;">${p.name}</td>
              <td style="padding: 7px 10px; border: 1px solid #e2e8f0;">${p.unit}</td>
              <td style="padding: 7px 10px; border: 1px solid #e2e8f0; font-weight: bold; color: #b45309;">${p.issued}</td>
              <td style="padding: 7px 10px; border: 1px solid #e2e8f0; font-weight: bold; color: #047857;">${p.returned}</td>
              <td style="padding: 7px 10px; border: 1px solid #e2e8f0; font-weight: bold; color: #0369a1;">${p.issued-p.returned}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>

    <!-- Section 2: Detailed Movements Table -->
    <div style="margin-bottom: 24px;">
      <h3 style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 8px; border-right: 4px solid #0284c7; padding-right: 8px;">
        \u062B\u0627\u0646\u064A\u0627\u064B: \u0633\u062C\u0644 \u0627\u0644\u062D\u0631\u0643\u0629 \u0627\u0644\u062A\u0641\u0635\u064A\u0644\u064A (\u0627\u0644\u0635\u0627\u062F\u0631 \u0648\u0627\u0644\u0645\u0631\u062A\u062C\u0639)
      </h3>
      <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: right;">
        <thead>
          <tr style="background-color: #0f172a; color: #ffffff;">
            <th style="padding: 8px 8px; border: 1px solid #334155;">#</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0627\u0644\u062A\u0627\u0631\u064A\u062E</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062A\u0648\u0631\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0646\u0648\u0639 \u0627\u0644\u0641\u0627\u062A\u0648\u0631\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0646\u0648\u0639 \u0627\u0644\u062D\u0631\u0643\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0627\u0644\u0639\u0645\u064A\u0644 / \u0627\u0644\u0645\u0633\u062A\u0644\u0645</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0627\u0644\u0643\u0645\u064A\u0629</th>
            <th style="padding: 8px 8px; border: 1px solid #334155;">\u0627\u0644\u0633\u0627\u0626\u0642 / \u0627\u0644\u0645\u0646\u062F\u0648\u0628</th>
          </tr>
        </thead>
        <tbody>
          ${Pt.length===0?`
            <tr>
              <td colspan="9" style="text-align: center; padding: 12px; color: #94a3b8; border: 1px solid #e2e8f0;">\u0644\u0627 \u062A\u0648\u062C\u062F \u062D\u0631\u0643\u0629 \u0645\u0633\u062C\u0644\u0629</td>
            </tr>
          `:Pt.map((p,F)=>`
            <tr style="background-color: ${p.movementType==="returned"?"#f0fdf4":F%2===0?"#ffffff":"#f8fafc"};">
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0; color: #64748b;">${F+1}</td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-family: monospace;">${p.date}</td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-family: monospace; font-weight: bold;">${p.invoiceNumber}</td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0;">
                <span style="display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; background-color: ${p.invoiceType==="cash"?"#dbeafe":"#f3e8ff"}; color: ${p.invoiceType==="cash"?"#1e40af":"#6b21a8"};">
                  ${p.invoiceType==="cash"?"\u0646\u0642\u062F\u064A":"\u0622\u062C\u0644"}
                </span>
              </td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0;">
                <span style="display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; background-color: ${p.movementType==="issued"?"#fef3c7":"#d1fae5"}; color: ${p.movementType==="issued"?"#92400e":"#065f46"};">
                  ${p.movementType==="issued"?"\u0635\u0627\u062F\u0631":"\u0645\u0631\u062A\u062C\u0639"}
                </span>
              </td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-weight: bold; color: #0f172a;">${p.itemName}</td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0;">${p.customerName||"---"}</td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0; font-weight: bold;">${p.quantity} ${p.unit||""}</td>
              <td style="padding: 6px 8px; border: 1px solid #e2e8f0; color: #475569;">${p.driverName||"---"}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>

    <!-- Signatures Footer -->
    <div style="margin-top: 36px; padding-top: 16px; border-top: 1px solid #cbd5e1; display: flex; justify-content: space-between; align-items: center; text-align: center; font-size: 11px; color: #475569;">
      <div style="width: 30%;">
        <p style="font-weight: bold; margin-bottom: 24px;">\u0623\u0645\u064A\u0646 \u0627\u0644\u0645\u062E\u0632\u0646</p>
        <p style="color: #94a3b8;">\u0627\u0644\u062A\u0648\u0642\u064A\u0639: .....................</p>
      </div>

      <div style="width: 30%;">
        <p style="font-weight: bold; margin-bottom: 24px;">\u0645\u062F\u064A\u0631 \u0627\u0644\u0645\u0628\u064A\u0639\u0627\u062A / \u0627\u0644\u062D\u0631\u0643\u0629</p>
        <p style="color: #94a3b8;">\u0627\u0644\u062A\u0648\u0642\u064A\u0639: .....................</p>
      </div>

      <div style="width: 30%;">
        <p style="font-weight: bold; margin-bottom: 24px;">\u0627\u0639\u062A\u0645\u0627\u062F \u0627\u0644\u0625\u062F\u0627\u0631\u0629</p>
        <p style="color: #94a3b8;">\u0627\u0644\u062A\u0648\u0642\u064A\u0639: .....................</p>
      </div>
    </div>
  `;try{let p=await xp(()=>Promise.resolve().then(()=>(ah(),oh)).then(h=>h.h),[]),F=p.default||p,_={margin:8,filename:`\u062A\u0642\u0631\u064A\u0631_\u0627\u0644\u0635\u0627\u062F\u0631_\u0648\u0627\u0644\u0645\u0631\u062A\u062C\u0639_${new Date().toISOString().slice(0,10)}.pdf`,image:{type:"jpeg",quality:.98},html2canvas:{scale:2,useCORS:!0,letterRendering:!0},jsPDF:{unit:"mm",format:"a4",orientation:"portrait"}};return await F().set(_).from(B).save(),!0}catch(p){console.error("PDF export error:",p);let F=window.open("","_blank");return F&&(F.document.write(`
        <!DOCTYPE html>
        <html dir="rtl" lang="ar">
        <head>
          <title>${dn}</title>
          <style>
            body { font-family: system-ui, sans-serif; padding: 20px; direction: rtl; }
            table { width: 100%; border-collapse: collapse; margin-top: 15px; }
            th, td { border: 1px solid #ccc; padding: 8px; text-align: right; }
            th { background: #f1f5f9; }
          </style>
        </head>
        <body>
          ${B.innerHTML}
          <script>
            window.onload = function() {
              window.print();
            };
          <\/script>
        </body>
        </html>
