\u0647\u0630\u0647 \u0627\u0644\u062D\u0632\u0645\u0629 \u062A\u062D\u062A\u0648\u064A \u0639\u0644\u0649 \u0645\u0644\u0641\u0627\u062A \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0644\u062A\u0639\u0645\u0644 \u0645\u0639\u0643 \u0628\u062F\u0648\u0646 \u0625\u0646\u062A\u0631\u0646\u062A:

1. **\u0637\u0631\u064A\u0642\u0629 \u0627\u0644\u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0627\u0644\u0641\u0648\u0631\u064A:**
   - \u0627\u0641\u062A\u062D \u0627\u0644\u0645\u0644\u0641: "\u062A\u0637\u0628\u064A\u0642_\u0627\u0644\u0645\u062E\u0632\u0648\u0646_\u0627\u0644\u0645\u0633\u062A\u0642\u0644.html" \u0641\u064A \u0645\u062A\u0635\u0641\u062D Google Chrome \u0639\u0644\u0649 \u062C\u0648\u0627\u0644\u0643 \u0623\u0648 \u062D\u0627\u0633\u0648\u0628\u0643.
   - \u0633\u064A\u0639\u0645\u0644 \u0645\u0639\u0643 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0641\u0648\u0631\u0627\u064B \u0628\u062F\u0648\u0646 \u0625\u0646\u062A\u0631\u0646\u062A \u0648\u062C\u0645\u064A\u0639 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A \u062A\u064F\u062D\u0641\u0638 \u0645\u062D\u0644\u064A\u0627\u064B \u0639\u0644\u0649 \u062C\u0647\u0627\u0632\u0643.

2. **\u0637\u0631\u064A\u0642\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629:**
   - \u064A\u0645\u0643\u0646\u0643 \u0625\u0631\u0633\u0627\u0644 \u0645\u0644\u0641 "\u062A\u0637\u0628\u064A\u0642_\u0627\u0644\u0645\u062E\u0632\u0648\u0646_\u0627\u0644\u0645\u0633\u062A\u0642\u0644.html" \u0644\u0623\u064A \u0634\u062E\u0635 \u0639\u0628\u0631 \u0627\u0644\u0648\u0627\u062A\u0633\u0627\u0628 \u0643\u0645\u0644\u0641.
   - \u0628\u0645\u062C\u0631\u062F \u0641\u062A\u062D\u0647\u060C \u0633\u064A\u062D\u0635\u0644 \u0639\u0644\u0649 \u0646\u0633\u062E\u062A\u0647 \u0627\u0644\u0645\u0633\u062A\u0642\u0644\u0629 \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0647.
`;Re.file("\u0627\u0642\u0631\u0623\u0646\u064A_\u0637\u0631\u064A\u0642\u0629_\u0627\u0644\u062A\u0634\u063A\u064A\u0644.txt",it);for(let ye of Ee)try{let S=await fetch(ye.path);if(S.ok){let Q=await S.blob();Re.file(ye.name,Q)}}catch(S){console.warn(`Could not fetch ${ye.path} for zip`)}let Ne=await Re.generateAsync({type:"blob"});Ru(Ne,`\u062D\u0632\u0645\u0629_${dn}_\u0643\u0627\u0645\u0644_\u0627\u0644\u0645\u0644\u0641\u0627\u062A.zip`)}async function rp(Pt="\u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u062E\u0632\u0648\u0646"){let dn=Pt.replace(/\s+/g,"_");try{let Re=await fetch("/android-github-release-project.zip");if(Re.ok){let Ee=await Re.blob();Ru(Ee,`\u0645\u0634\u0631\u0648\u0639_\u0623\u0646\u062F\u0631\u0648\u064A\u062F_${dn}_\u0645\u0639_Github_Actions_\u0643\u0627\u0645\u0644.zip`);return}}catch(Re){console.warn("Direct fetch of android-github-release-project.zip failed, trying fallback:",Re)}try{let Re=await fetch("/android-project.zip");if(Re.ok){let Ee=await Re.blob();Ru(Ee,`\u0645\u0634\u0631\u0648\u0639_\u0623\u0646\u062F\u0631\u0648\u064A\u062F_${dn}_\u0645\u0639_Github_Actions_\u0643\u0627\u0645\u0644.zip`);return}}catch(Re){console.warn("Direct fetch of android-project.zip failed:",Re)}xh(Pt)}async function xg(Pt="\u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u062E\u0632\u0648\u0646"){let dn=Pt.replace(/\s+/g,"_"),Re=new vp,Ee=[{path:"/standalone.html",name:"app-release-offline.html"},{path:"/manifest.json",name:"AndroidManifest.json"},{path:"/sw.js",name:"service-worker.js"},{path:"/icon-512.png",name:"app-icon-hd.png"},{path:"/icon-192.png",name:"app-icon.png"},{path:"/icon.svg",name:"app-vector-icon.svg"}],it=`# \u062F\u0644\u064A\u0644 \u062A\u062B\u0628\u064A\u062A \u0648\u062A\u0634\u063A\u064A\u0644 \u062A\u0637\u0628\u064A\u0642 \u0623\u0646\u062F\u0631\u0648\u064A\u062F (${Pt})
==================================================

\u062A\u0647\u0627\u0646\u064A\u0646\u0627! \u0644\u062F\u064A\u0643 \u0627\u0644\u0622\u0646 \u0627\u0644\u062D\u0632\u0645\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0644\u062A\u0634\u063A\u064A\u0644 \u0648\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0639\u0644\u0649 \u062C\u0648\u0627\u0644\u0643 \u0628\u0646\u0638\u0627\u0645 Android \u0645\u062B\u0644 \u0623\u064A \u062A\u0637\u0628\u064A\u0642 \u0642\u0627\u062F\u0645 \u0645\u0646 \u0645\u062A\u062C\u0631 Google Play:

\u0637\u0631\u064A\u0642\u0629 1 (\u0627\u0644\u0623\u0633\u0647\u0644 \u0648\u0627\u0644\u0623\u0633\u0631\u0639 - \u062A\u062B\u0628\u064A\u062A WebAPK \u0645\u0628\u0627\u0634\u0631 \u0628\u0636\u063A\u0637\u0629 \u0632\u0631):
-------------------------------------------------------
1. \u0627\u0641\u062A\u062D \u0631\u0627\u0628\u0637 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0641\u064A \u0645\u062A\u0635\u0641\u062D Google Chrome \u0639\u0644\u0649 \u062C\u0648\u0627\u0644\u0643:
2. \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0632\u0631 "\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0637\u0628\u064A\u0642" \u0623\u0648 \u0645\u0646 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 (\u22EE) \u0627\u062E\u062A\u0631 "\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629 / \u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0637\u0628\u064A\u0642".
3. \u0633\u064A\u0642\u0648\u0645 \u0623\u0646\u062F\u0631\u0648\u064A\u062F \u0628\u0625\u0646\u0634\u0627\u0621 \u062D\u0632\u0645\u0629 WebAPK \u0631\u0633\u0645\u064A\u0629 \u0648\u062A\u062B\u0628\u064A\u062A \u0623\u064A\u0642\u0648\u0646\u0629 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0641\u064A \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062A\u0637\u0628\u064A\u0642\u0627\u062A \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629 \u0639\u0644\u0649 \u062C\u0648\u0627\u0644\u0643.
4. \u064A\u0641\u062A\u062D \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0628\u0645\u0644\u0621 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0628\u062F\u0648\u0646 \u0634\u0631\u064A\u0637 \u0645\u062A\u0635\u0641\u062D \u0648\u0628\u062F\u0648\u0646 \u0625\u0646\u062A\u0631\u0646\u062A \u0646\u0647\u0627\u0626\u064A\u0627\u064B!

\u0637\u0631\u064A\u0642\u0629 2 (\u0627\u0644\u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0644\u0645\u0644\u0641 \u0627\u0644\u062A\u0637\u0628\u064A\u0642):
----------------------------------------
- \u0627\u0641\u062A\u062D \u0645\u0644\u0641 "app-release-offline.html" \u0641\u064A \u062C\u0648\u0627\u0644\u0643 \u0648\u0633\u064A\u0639\u0645\u0644 \u0641\u0648\u0631\u0627\u064B \u062F\u0648\u0646 \u0627\u062A\u0635\u0627\u0644.

\u0637\u0631\u064A\u0642\u0629 3 (\u0628\u0646\u0627\u0621 \u0645\u0644\u0641 APK \u0631\u0633\u0645\u064A \u0639\u0628\u0631 Android Studio):
------------------------------------------------
- \u062D\u0645\u0651\u0644 \u062D\u0632\u0645\u0629 "\u0645\u0634\u0631\u0648\u0639 \u0623\u0646\u062F\u0631\u0648\u064A\u062F Android Studio" \u0645\u0646 \u0632\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0648\u0627\u0641\u062A\u062D\u0647 \u0641\u064A Android Studio \u0648\u0627\u0636\u063A\u0637 Build APK.
